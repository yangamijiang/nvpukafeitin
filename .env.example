# Production requires the exact public HTTPS origin, without a trailing slash.
NODE_ENV=production
APP_ORIGIN=https://your-cafe.example.com
PORT=3000
# Put this path on a persistent volume; do not use an ephemeral filesystem.
DATABASE_PATH=/app/data/komorebi.sqlite
# Generate a random secret in your host's secure environment settings.
# Do not commit the real value. Remove it after initial administrator setup.
ADMIN_SETUP_KEY=
# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=1
